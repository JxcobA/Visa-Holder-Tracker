+package visa_holder_tracker.dto;
+
+import visa_holder_tracker.entity.Movement;
+import java.time.LocalDateTime;
+
+// Was created solely to serve as a one way response to
+public record MovementResponse(Long id, LocalDateTime entryDate,
+                               LocalDateTime exitDate, String passportNumber) {
+    public static MovementResponse from(Movement movement) {
